# Twitch API Credentials (Required)
# Get these from: https://dev.twitch.tv/console/apps
TWITCH_CLIENT_ID=your_twitch_client_id
TWITCH_CLIENT_SECRET=your_twitch_client_secret

# Supabase Configuration (Optional - for dynamic streamer management)
# Get these from: Supabase Dashboard > Settings > API
# If not configured, the app will use the static streamer list from data/data.ts
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_DEFAULT_KEY=your_supabase_anon_key

# Featured User ID (Optional - for highlights section)
# Defaults to 530941879 (randobrasil) if not set
FEATURED_USER_ID=530941879

# Discord OAuth Configuration (Required for Connect feature)
# Get these from: https://discord.com/developers/applications
DISCORD_CLIENT_ID=your_discord_client_id
DISCORD_CLIENT_SECRET=your_discord_client_secret
DISCORD_REDIRECT_URI=http://localhost:3000/api/auth/discord/callback

# Bot API Configuration (Required for Connect feature)
# URL of your Discord bot's API for guild membership checks
BOT_API_URL=http://localhost:3001

# Session Encryption Key (Required for Connect feature)
# Generate with: openssl rand -base64 32
SESSION_SECRET=your_32_byte_base64_encoded_secret
