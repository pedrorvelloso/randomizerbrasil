# Twitch API Credentials (Required)
# Get these from: https://dev.twitch.tv/console/apps
TWITCH_CLIENT_ID=your_twitch_client_id
TWITCH_CLIENT_SECRET=your_twitch_client_secret

# Supabase Configuration (Optional - for dynamic streamer management)
# Get these from: Supabase Dashboard > Settings > API
# If not configured, the app will use the static streamer list from data/data.ts
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_DEFAULT_KEY=your_supabase_anon_key

# Featured User ID (Optional - for highlights section)
# Defaults to 530941879 (randobrasil) if not set
FEATURED_USER_ID=530941879
